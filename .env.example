# Server
PORT=8787
HOST=127.0.0.1
# Allowed browser origins for HTTP + WebSocket (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
# SQLite file (single-instance baseline)
DATABASE_PATH=apps/server/var/vicepulse.db
# Secret used to sign the guest session cookie. Change in any shared deployment.
SESSION_SECRET=change-me-to-a-long-random-string
# Enables demo controls (restart story, advance time). Demo controls never issue transferable rewards.
DEMO_CONTROLS=true
# Simulation seed for the shared demonstration world
WORLD_SEED=night-shift-001

# Narrative provider: "deterministic" (default, no key needed) or "openai-compatible"
NARRATIVE_PROVIDER=deterministic
NARRATIVE_API_BASE=
NARRATIVE_API_KEY=
NARRATIVE_MODEL=
NARRATIVE_TIMEOUT_MS=4000
NARRATIVE_MAX_TOKENS=160

# Rewards settlement: "disabled" (default) or "mock" (tests only). Chain adapters are not implemented.
SETTLEMENT_ADAPTER=disabled

# Tile / photo cache: fetch missing GTADB tiles from the pinned GitHub commit on demand
TILE_FETCH_ON_DEMAND=true
TILE_FETCH_DAILY_BUDGET=800
